{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting for Handy",
  "version": "1.1.0-beta.1",
  "identifier": "org.handymeeting.beta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Meeting for Handy",
        "width": 1180,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; media-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../../../assets/handymeeting.ico",
      "../../../assets/handymeeting.png"
    ],
    "copyright": "Meeting for Handy contributors",
    "shortDescription": "Independent local meeting companion for Handy"
  }
}
